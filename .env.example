# =====================================================================
# SeemaSetu — Environment Configuration Blueprint
# Copy this file to '.env' and update with your local or cloud settings
# Never commit '.env' or real credentials into version control!
# =====================================================================

# Flask Secret Key (Generate a cryptographically random string for production)
SECRET_KEY=seemasetu-border-infra-secure-production-key-2026

# Database Type: 'mysql' for production MySQL / TiDB / PlanetScale / Azure Database for MySQL,
# or 'sqlite' for zero-configuration local development.
DB_TYPE=sqlite

# MySQL Connection Settings (Required when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=seemasetu_db

# File Upload Threshold (Bytes, default 5MB = 5242880)
MAX_CONTENT_LENGTH=5242880

# Production Cookie Security (Set to True on HTTPS in Vercel)
SESSION_COOKIE_SECURE=False

# Optional Persistent Cloud Photo Storage (Recommended for Vercel Serverless)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=seemasetu-uploads
